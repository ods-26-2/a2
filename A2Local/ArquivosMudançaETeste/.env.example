# ============================================================
# KAFKA
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=34.66.235.91:9093
KAFKA_TOPIC=ods.i6.code_read
KAFKA_GROUP_ID=a2-controle-acesso
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_DEDUP_TTL=60


# ============================================================
# QR - AES
# ============================================================

# Chave TEMPORÁRIA de teste.
# Trocar depois pela chave definitiva.
A2_AES_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa


# ============================================================
# A2
# ============================================================

A2_SIMULATION=false
A2_DEFAULT_MAX_PENDING_AGE=2.0


# ============================================================
# REDE
# ============================================================

# Callback das catracas/celular -> Jetson -> Docker -> A2
A2_MONITOR_BIND_IP=0.0.0.0

# API local de logs acessível pela LAN.
# No deploy final podemos trocar por IP fixo da Jetson.
A2_LOG_API_BIND_IP=0.0.0.0


# ============================================================
# LOGS
# ============================================================

A2_LOG_RETENTION_DAYS=30
A2_LOG_CLEANUP_INTERVAL_SECONDS=21600
# ============================================================
# S4 - EVIDÊNCIA DE MÍDIA
# ============================================================

# true:
#   S4 ainda não existe.
#   O A2 cria uma evidência falsa READY no log.
#
# false:
#   A2 publica ods.s4.capture.command e passa a consumir
#   reply + ods.s4.clip pelo Kafka.
TESTE_S4=true

# Tópicos configuráveis para não amarrar o A2 à implantação
# do S4 enquanto a equipe ainda não definiu os nomes finais.
S4_CAPTURE_COMMAND_TOPIC=ods.s4.capture.command
S4_CAPTURE_REPLY_TOPIC=ods.s4.capture.command.reply
S4_CLIP_TOPIC=ods.s4.clip

# ============================================================
# RECONEXÃO / RESILIÊNCIA
# ============================================================

# Intervalo entre tentativas de reconexão de cada catraca.
A2_TURNSTILE_RETRY_SECONDS=5

# Intervalo entre tentativas de reabrir o monitor HTTP :8000.
A2_MONITOR_RETRY_SECONDS=5

# Se liberar.py ou acessos_api.py sofrerem crash real,
# o entrypoint reinicia apenas o processo que caiu.
A2_PROCESS_RESTART_SECONDS=2

